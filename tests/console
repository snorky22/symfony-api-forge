#!/usr/bin/env php
<?php

// Console of the test application, for the development of the bundle: php tests/console list
// Environment "dev": real HTTP requests, with the keys of .env.local (git-ignored), e.g. for api-forge:call.
// PHPUnit runs the "test" environment, where the HTTP clients answer from ApiMock.

use Snorky22\ApiForge\Tests\App\TestKernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;
use Symfony\Component\Dotenv\Dotenv;

require dirname(__DIR__).'/vendor/autoload.php';

if (is_file(dirname(__DIR__).'/.env.local')) {
    (new Dotenv())->load(dirname(__DIR__).'/.env.local');
}

exit((new Application(new TestKernel($_SERVER['APP_ENV'] ?? 'dev', true)))->run());
