# Static analysis. For now limited to the hand-written REST resources and their maker; the rest of src/ is to be
# brought to the level progressively. Level 6: the shape of a decoded response is a declaration about the API, not
# something PHPStan can prove (from level 7, returning it from request() is reported).
parameters:
    level: 6
    paths:
        - src/Core/Rest
        - src/DependencyInjection/ResourceLocatorPass.php
        - src/Dev/Rest
        - src/Command/CallCommand.php
        - src/Command/MakeResourceCommand.php
        - src/Command/MakeWebhookCommand.php
        - src/Core/Webhook
        - src/Dev/Webhook/WebhookMaker.php
        - tests/Core/Rest
        - tests/DependencyInjection
        - tests/Dev/Rest
        - tests/Command/CallCommandTest.php
        - tests/Command/MakeResourceCommandTest.php
        - tests/Command/MakeWebhookCommandTest.php
        - tests/Dev/Webhook/WebhookMakerTest.php
