{
    "name": "snorky22/symfony-api-forge",
    "description": "Generate Symfony services for REST APIs and webhooks from the API's documentation: curl and JSON examples become editable descriptors, from which typed HTTP clients and signed webhook consumers are regenerated.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "code-generator", "rest-api", "webhooks", "api-client", "json-api", "http-client", "phpstan", "curl"],
    "homepage": "https://github.com/snorky22/symfony-api-forge",
    "authors": [
        {
            "name": "snorky22",
            "homepage": "https://github.com/snorky22"
        }
    ],
    "support": {
        "issues": "https://github.com/snorky22/symfony-api-forge/issues",
        "source": "https://github.com/snorky22/symfony-api-forge",
        "docs": "https://github.com/snorky22/symfony-api-forge/tree/master/docs"
    },
    "require": {
        "php": ">=8.2",
        "phpstan/phpdoc-parser": "^2.0",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/remote-event": "^7.4",
        "symfony/string": "^7.4",
        "symfony/var-exporter": "^7.4",
        "symfony/webhook": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/browser-kit": "^7.4",
        "symfony/messenger": "^7.4"
    },
    "suggest": {
        "symfony/messenger": "To process webhook events asynchronously"
    },
    "autoload": {
        "psr-4": {
            "Snorky22\\ApiForge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Snorky22\\ApiForge\\Tests\\": "tests/",
            "App\\": "examples/lemonsqueezy/src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
