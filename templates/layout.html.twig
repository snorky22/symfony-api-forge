<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} · api-forge</title>
    <link rel="stylesheet" href="/assets/bootstrap.min.css">
{% if editor|default(false) %}    <link rel="stylesheet" href="/assets/editor.css">
{% endif %}</head>
<body class="bg-body-tertiary">
<nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="/">api-forge</a>
        <span class="navbar-text small">local interface · nothing leaves your machine</span>
    </div>
</nav>
<main class="container pb-5">
{% block content %}{{ content|default('')|raw }}{% endblock %}
</main>
{% if editor|default(false) %}
<script src="/assets/ace/ace.js"></script>
<script src="/assets/editor.js" data-token="{{ token }}"></script>
{% endif %}
</body>
</html>
