<ul class="nav nav-pills mb-3">
{% for key, label in {'new': '1. Endpoint', 'request': '2. Request', 'response': '3. Response', 'import': '4. Import'} %}
    <li class="nav-item">
    {% if base is null and 'new' != key %}
        <span class="nav-link disabled">{{ label }}</span>
    {% elseif 'new' == key %}
        <a class="nav-link {{ 'new' == step ? 'active' }}" href="/api/{{ api }}/endpoint">{{ label }}</a>
    {% else %}
        <a class="nav-link {{ key == step ? 'active' }}" href="/api/{{ api }}/endpoint?base={{ base }}&amp;step={{ key }}">{{ label }}</a>
    {% endif %}
    </li>
{% endfor %}
</ul>
