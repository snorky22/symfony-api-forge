{% extends 'layout.html.twig' %}
{% block content %}
<h1 class="h3 mb-1">Generate the code <small class="text-secondary">{{ api }}</small></h1>
<p class="text-secondary">Writes the services, the doctor and the HTTP client configuration from the descriptors. Generated files are never edited by hand:
fix the examples and generate again. The button runs <code>{{ command }}</code> for you.</p>

{% if result is null %}
    {% if progress.errors is not empty %}
        <div class="alert alert-danger"><strong>The descriptors are invalid:</strong><ul class="mb-0">{% for error in progress.errors|slice(0, 8) %}<li>{{ error|replace({(projectDir ~ '/'): ''}) }}</li>{% endfor %}</ul></div>
    {% elseif progress.review is not empty %}
        <div class="alert alert-warning">{{ progress.review|length }} review note(s) left: you can generate anyway, <a href="/api/{{ api }}/notes">or review them</a>.</div>
    {% endif %}
    <p>{{ progress.operations }} operation(s); {{ progress.stale|length }} generated file(s) out of date.</p>
    <form method="post" action="/api/{{ api }}/generate">
        <input type="hidden" name="_token" value="{{ token }}">
        <button class="btn btn-primary">Generate</button> <a class="btn btn-link" href="/api/{{ api }}">Back</a>
    </form>
{% elseif not result.isValid() %}
    <div class="alert alert-danger"><strong>The descriptors are invalid:</strong><ul class="mb-0">{% for error in result.errors %}<li>{{ error|replace({(projectDir ~ '/'): ''}) }}</li>{% endfor %}</ul></div>
    <a class="btn btn-outline-secondary" href="/api/{{ api }}">Back</a>
{% else %}
    {% if result.review is not empty %}<div class="alert alert-warning">{{ result.review|length }} review note(s) left in the descriptors.</div>{% endif %}
    {% if result.isUpToDate() %}
        <div class="alert alert-success">The {{ result.files }} generated files are up to date.</div>
    {% else %}
        <div class="alert alert-success">{{ result.changes|length }} file(s) changed.</div>
        <table class="table table-sm"><thead><tr><th>Change</th><th>File</th></tr></thead><tbody>
        {% for change in result.changes %}<tr><td>{{ change[0] }}</td><td><code>{{ change[1] }}</code></td></tr>{% endfor %}
        </tbody></table>
    {% endif %}
    <a class="btn btn-primary" href="/api/{{ api }}/doctor">Check with the doctor</a>
    <a class="btn btn-outline-secondary" href="/api/{{ api }}">Back to {{ api }}</a>
{% endif %}
{% endblock %}
