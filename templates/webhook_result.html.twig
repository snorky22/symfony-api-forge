{% extends 'layout.html.twig' %}
{% block content %}
<h1 class="h3 mb-3">Imported <small class="text-secondary"><code>{{ event }}</code></small></h1>

<div class="card mb-3"><div class="card-body">
    <h2 class="h6">What changed</h2>
    <ul class="mb-0">{% for line in done %}<li>{{ line }}</li>{% endfor %}</ul>
</div></div>

<div class="row mb-3">
    <div class="col-md-6">
        <h2 class="h6">Examples written</h2>
        <ul class="list-group">
        {% for file in written %}
            <li class="list-group-item d-flex justify-content-between align-items-center"><code>{{ file }}</code>
                <a href="/api/{{ api }}/file?name={{ file|url_encode }}&amp;area=examples" data-af-open>Edit</a></li>
        {% endfor %}
        </ul>
    </div>
    <div class="col-md-6">
        <h2 class="h6">Descriptors</h2>
        <ul class="list-group">
        {% for file in descriptors %}
            <li class="list-group-item d-flex justify-content-between align-items-center"><code>{{ file }}</code>
                <a href="/api/{{ api }}/file?name={{ file|url_encode }}&amp;area=descriptors" data-af-open>Edit</a></li>
        {% endfor %}
        </ul>
    </div>
</div>

{% if eventNotes is not empty %}
    <div class="alert alert-warning">
        <strong>{{ eventNotes|length }} note(s) on <code>{{ event }}</code></strong>: what the example and its docs page could not settle.
        <ul class="mb-0 mt-1">{% for note in eventNotes %}<li>{{ note }}</li>{% endfor %}</ul>
    </div>
{% else %}
    <div class="alert alert-success">No note on <code>{{ event }}</code>.</div>
{% endif %}
{% if otherNotes > 0 %}<p class="text-secondary small">{{ otherNotes }} other webhook note(s) in <code>_webhooks.yaml</code>.</p>{% endif %}

<p>{{ state.typed }} of {{ state.total }} events typed.</p>
<a class="btn btn-primary" href="/api/{{ api }}/notes">Review the notes</a>
<a class="btn btn-outline-primary" href="/api/{{ api }}/generate">Generate</a>
<a class="btn btn-outline-secondary" href="/api/{{ api }}/webhooks">Back to the webhooks</a>
{% endblock %}
