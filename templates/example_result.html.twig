{% extends 'layout.html.twig' %}
{% block content %}
<h1 class="h3 mb-3">Imported <small class="text-secondary">{{ api }}</small></h1>

{% if named is not null and named != result.operation ~ '-' ~ result.resource %}
    <div class="alert alert-warning">The files are named <code>{{ named }}</code>, but the request is the <strong>{{ result.operation }}</strong> operation of
    <strong>{{ result.resource }}</strong>. api-forge reads the request, not the name; rename the files to keep the convention.</div>
{% endif %}

<div class="card mb-3"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Operation</dt><dd class="col-sm-9"><code>{{ result.resource }}.{{ result.operation }}</code></dd>
        <dt class="col-sm-3">Endpoint</dt><dd class="col-sm-9 mb-0"><code>{{ result.endpoint }}</code></dd>
    </dl>
    {% if result.notes is not empty %}<ul class="mt-2 mb-0">{% for note in result.notes %}<li>{{ note }}</li>{% endfor %}</ul>{% endif %}
</div></div>

<div class="mb-3">
    <div class="mb-3">
        <h2 class="h6">Examples written</h2>
        <ul class="list-group">
        {% for file in files %}
            <li class="list-group-item d-flex justify-content-between align-items-center"><code>{{ file }}</code>
                <a href="/api/{{ api }}/file?name={{ file|url_encode }}&amp;area=examples" data-af-open>Edit</a></li>
        {% endfor %}
        </ul>
    </div>
    <div>
        <h2 class="h6">Descriptors</h2>
        <ul class="list-group">
        {% for file in descriptors %}
            <li class="list-group-item d-flex justify-content-between align-items-center"><code>{{ file }}</code>
                <a href="/api/{{ api }}/file?name={{ file|url_encode }}&amp;area=descriptors" data-af-open>Edit</a></li>
        {% endfor %}
        </ul>
    </div>
</div>

{% if result.review is not empty %}
    <div class="alert alert-warning">
        <strong>{{ result.review|length }} note(s) to review</strong> (the importer guessed):
        <ul class="mb-0">{% for note in result.review %}<li>{{ note }}</li>{% endfor %}</ul>
    </div>
{% endif %}

<a class="btn btn-primary" href="/api/{{ api }}/notes">Review the notes</a>
<a class="btn btn-outline-primary" href="/api/{{ api }}/example">Add another example</a>
<a class="btn btn-outline-secondary" href="/api/{{ api }}">Back to {{ api }}</a>
{% endblock %}
